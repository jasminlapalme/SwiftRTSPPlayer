        }
      }
    },
    "error.cannotOpenURL" : {
      "comment" : "Error message when avformat_open_input fails on the supplied RTSP URL.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot open RTSP URL"
