        }
      }
    },
    "error.cannotFindStreamInfo" : {
      "comment" : "Error message when avformat_find_stream_info fails.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
