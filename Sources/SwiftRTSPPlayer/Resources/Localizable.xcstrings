    "error.cannotCreateDecompressionSession" : {
      "comment" : "Error message when VTDecompressionSessionCreate fails.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
