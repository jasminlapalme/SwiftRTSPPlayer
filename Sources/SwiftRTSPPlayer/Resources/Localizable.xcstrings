          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de créer la session de décompression H.264"
          }
        }
      }
    },
    "error.cannotCreateFormatDescription" : {
      "comment" : "Error message when CMVideoFormatDescriptionCreateFromH264ParameterSets fails.",
