        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponse invalide de la caméra"
          }
        }
      }
    },
    "error.onvif.malformedStreamURL" : {
      "comment" : "Error shown when GetStreamUri returns a string that is not a valid URL.",
